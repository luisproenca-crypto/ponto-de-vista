# ------------------------------------------------------------------
# PONTO DE VISTA — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha o que for usar.
# Nenhuma variável é obrigatória: o site funciona sem todas elas.
# ------------------------------------------------------------------

# Endereço público do site (usado nos metadados / Open Graph).
# Ex.: https://pontodevista.com.br — em desenvolvimento pode ficar vazio.
NEXT_PUBLIC_SITE_URL=

# Link do grupo/comunidade dos alunos (WhatsApp, Telegram, Discord...).
# Se ficar vazio, a página /comunidade mostra "Link disponível em breve".
NEXT_PUBLIC_COMMUNITY_URL=

# E-mail de suporte exibido na página /ajuda.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Código de acesso compartilhado da turma (proteção simples do portal).
# ATENÇÃO: não use o prefixo NEXT_PUBLIC_ aqui — esta variável é lida
# apenas no servidor e nunca é enviada para o navegador.
# Se ficar vazia, o site funciona SEM nenhuma barreira de acesso.
COURSE_ACCESS_CODE=

# Supabase Auth (login individual por Magic Link) — infraestrutura em
# construção. Enquanto vazias, /login e /auth/* não funcionam, mas o
# restante do site (incluindo a barreira COURSE_ACCESS_CODE acima)
# continua funcionando normalmente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
